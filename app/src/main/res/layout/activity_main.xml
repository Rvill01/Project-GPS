<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">



        <!-- MAPA -->
        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- CONTENEDOR DE FRAGMENTOS (encima del mapa si lo usas) -->
        <FrameLayout
            android:id="@+id/containerFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- BOTÓN FLOTANTE -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="Buscar ruta"
            app:srcCompat="@android:drawable/ic_menu_search"
            app:tint="@android:color/white"
            android:backgroundTint="@color/teal_700" />

        <!-- BARRA INFERIOR PARA CREAR RUTA -->
        <!-- BARRA INFERIOR PARA CREAR RUTA -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabUbic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:backgroundTint="@color/red"
            android:contentDescription="Ubicar en mapa"
            app:srcCompat="@android:drawable/ic_menu_mapmode"
            app:tint="@android:color/white" />

        <LinearLayout
            android:id="@+id/layoutCreacionRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@color/teal_700"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPuntosCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Puntos: 0"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnGuardarRuta"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="Guardar ruta"
                app:tint="@android:color/white" />

        </LinearLayout>


    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- MENÚ LATERAL -->
    <com.google.android.material.navigation.NavigationView

        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_principal" />

</androidx.drawerlayout.widget.DrawerLayout>
